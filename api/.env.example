# Copy to .env and/or .env.local and fill in. The server loads .env then overrides from .env.local (gitignored).

# Railway Postgres (required)
DATABASE_URL=

# Auth — sign JWTs for mobile/admin clients (min 32 chars)
JWT_SECRET=

OPENAI_API_KEY=

# Comma-separated emails allowed for /v1/admin/*
ADMIN_EMAILS=
CATALOG_ADMIN_EMAILS=neil@blueprintapps.io

PORT=8787

# Optional: disable SSL for local Postgres
# PGSSL=false
